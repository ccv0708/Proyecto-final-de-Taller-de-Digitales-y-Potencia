      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n\n#define parametro(indice) ParamRealData(0, (indice))\n\nstatic double referencia(double t, double f, double amp_ini, double amp_fin, double cambio)\n{\n    const double amplitud = t < cambio ? amp_ini : amp_fin;\n    return amplitud * sin(6.283185307179586 * f * t);\n}\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "for (int k = 0; k < 5; ++k) {\n    DiscState(k) = 0.0;\n}\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "const int permiso = DiscState(4) == 0.0;\nOutputSignal(0, 0) = permiso ? DiscState(2) : 0.0;\nOutputSignal(1, 0) = permiso ? 1.0 : 0.0;\nOutputSignal(2, 0) = referencia(CurrentTime, parametro(0), parametro(1), parametro(2), parametro(3));\nOutputSignal(3, 0) = CurrentTime < parametro(4) ? 1.0 : 0.0;\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "const double medida = InputSignal(0, 0);\nconst double inyeccion = (CurrentTime >= parametro(14) &&\n                         CurrentTime < parametro(14) + parametro(16)) ? parametro(15) : 0.0;\nconst double medida_proteccion = medida + inyeccion;\nconst double kp = parametro(5);\nconst double kr = parametro(6);\nconst double b0 = parametro(7);\nconst double b2 = parametro(8);\nconst double a1 = parametro(9);\nconst double a2 = parametro(10);\nconst double vdc = parametro(11);\nconst double limite = parametro(12) * vdc;\nconst double umbral = parametro(13);\n\nif (!isfinite(medida_proteccion)) {\n    DiscState(4) = 1.0;\n} else if (fabs(medida_proteccion) > umbral) {\n    DiscState(3) += 1.0;\n    if (DiscState(3) >= 3.0) {\n        DiscState(4) = 1.0;\n    }\n} else {\n    DiscState(3) = 0.0;\n}\nif (DiscState(4) != 0.0 || !isfinite(InputSignal(1, 0))) {\n    DiscState(0) = DiscState(1) = DiscState(2) = 0.0;\n    DiscState(4) = 1.0;\n    return;\n}\n\nconst double e = referencia(CurrentTime, parametro(0), parametro(1), parametro(2), parametro(3)) - InputSignal(1, 0);\nconst double u = (kp + b0) * e + DiscState(0);\nconst double u_sat = fmin(limite, fmax(-limite, u));\nconst double e_estado = e + (u_sat - u) / (kp + kr);\nconst double yr_estado = b0 * e_estado + DiscState(0);\nDiscState(0) = -a1 * yr_estado + DiscState(1);\nDiscState(1) = b2 * e_estado - a2 * yr_estado;\nDiscState(2) = u_sat / vdc;\n"
        Show          off
      }
    }
