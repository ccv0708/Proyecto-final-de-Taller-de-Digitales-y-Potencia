    Component {
      Type          CScript
      Name          "PR_y_supervisor"
      Show          on
      Position      [185, 740]
      Direction     right
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "[1 1]"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "[1 1 1 1]"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "5"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "[0 0]"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "T_control"
        Show          off
      }
      Parameter {
        Variable      "TerminalBasedSampleTimes"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "PR_config"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n"
"\n"
"#define parametro(indice) ParamRealData(0, (indice))\n"
"\n"
"static double referencia(double t, double f, double amp_ini, double amp_fin, "
"double cambio)\n"
"{\n"
"    const double amplitud = t < cambio ? amp_ini : amp_fin;\n"
"    return amplitud * sin(6.283185307179586 * f * t);\n"
"}\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "for (int k = 0; k < 5; ++k) {\n"
"    DiscState(k) = 0.0;\n"
"}\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "const int permiso = DiscState(4) == 0.0;\n"
"OutputSignal(0, 0) = permiso ? DiscState(2) : 0.0;\n"
"OutputSignal(1, 0) = permiso ? 1.0 : 0.0;\n"
"OutputSignal(2, 0) = referencia(CurrentTime, parametro(0), parametro(1), para"
"metro(2), parametro(3));\n"
"OutputSignal(3, 0) = CurrentTime < parametro(4) ? 1.0 : 0.0;\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "const double medida = InputSignal(0, 0);\n"
"const double inyeccion = (CurrentTime >= parametro(14) &&\n"
"                         CurrentTime < parametro(14) + parametro(16)) ? param"
"etro(15) : 0.0;\n"
"const double medida_proteccion = medida + inyeccion;\n"
"const double kp = parametro(5);\n"
"const double kr = parametro(6);\n"
"const double b0 = parametro(7);\n"
"const double b2 = parametro(8);\n"
"const double a1 = parametro(9);\n"
"const double a2 = parametro(10);\n"
"const double vdc = parametro(11);\n"
"const double limite = parametro(12) * vdc;\n"
"const double umbral = parametro(13);\n"
"\n"
"if (!isfinite(medida_proteccion)) {\n"
"    DiscState(4) = 1.0;\n"
"} else if (fabs(medida_proteccion) > umbral) {\n"
"    DiscState(3) += 1.0;\n"
"    if (DiscState(3) >= 3.0) {\n"
"        DiscState(4) = 1.0;\n"
"    }\n"
"} else {\n"
"    DiscState(3) = 0.0;\n"
"}\n"
"if (DiscState(4) != 0.0 || !isfinite(InputSignal(1, 0))) {\n"
"    DiscState(0) = DiscState(1) = DiscState(2) = 0.0;\n"
"    DiscState(4) = 1.0;\n"
"    return;\n"
"}\n"
"\n"
"const double e = referencia(CurrentTime, parametro(0), parametro(1), parametr"
"o(2), parametro(3)) - InputSignal(1, 0);\n"
"const double u = (kp + b0) * e + DiscState(0);\n"
"const double u_sat = fmin(limite, fmax(-limite, u));\n"
"const double e_estado = e + (u_sat - u) / (kp + kr);\n"
"const double yr_estado = b0 * e_estado + DiscState(0);\n"
"DiscState(0) = -a1 * yr_estado + DiscState(1);\n"
"DiscState(1) = b2 * e_estado - a2 * yr_estado;\n"
"DiscState(2) = u_sat / vdc;\n"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
